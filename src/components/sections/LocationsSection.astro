---
import { getLocationText } from "@/config/site"
import { MapPin, ArrowRight } from "lucide-react"
import AnimateOnScroll from "@/components/AnimateOnScroll.astro"

interface Location {
  name: string
  href: string
  description?: string
}

interface Props {
  badge?: string
  title: string
  description?: string
  overlayBadge?: string
  overlayTitle?: string
  locations?: Location[]
  mapCenter?: { lat: number; lng: number }
  mapUrl?: string
  variant?: "overlay" | "overlay-titled" | "split" | "cards" | "full" | "half"
}

const {
  badge,
  title,
  description,
  overlayBadge = "Service Areas",
  overlayTitle = "Serving the Denver Metro Area",
  locations = [],
  mapCenter = { lat: 39.7392, lng: -104.9903 },
  mapUrl: customMapUrl,
  variant = "overlay",
} = Astro.props

const processedTitle = getLocationText(title)
const processedDescription = description ? getLocationText(description) : undefined
const processedBadge = badge ? getLocationText(badge) : undefined
const processedOverlayBadge = getLocationText(overlayBadge)
const processedOverlayTitle = getLocationText(overlayTitle)

const splitOverlay = (t: string) => {
  const words = t.split(" ")
  if (words.length < 3) return { head: t, tail: "" }
  const mid = Math.ceil(words.length / 2)
  return { head: words.slice(0, mid).join(" "), tail: words.slice(mid).join(" ") }
}
const { head: overlayHead, tail: overlayTail } = splitOverlay(processedOverlayTitle)

const mapUrl = customMapUrl || `https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d196281.12937236!2d${mapCenter.lng}!3d${mapCenter.lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sus!4v1704067200000!5m2!1sen!2sus`

const splitTitle = (t: string) => {
  if (t.includes("\n")) {
    const [a, ...rest] = t.split("\n")
    return { head: a.trim(), tail: rest.join(" ").trim() }
  }
  const words = t.split(" ")
  if (words.length < 3) return { head: t, tail: "" }
  const mid = Math.ceil(words.length / 2)
  return { head: words.slice(0, mid).join(" "), tail: words.slice(mid).join(" ") }
}
const { head, tail } = splitTitle(processedTitle)
---

<section class="py-20 md:py-28 bg-white">
  <div class="container mx-auto px-4">
    {variant === "full" && (
      <>
        <AnimateOnScroll animation="fade-up">
          <div class="text-center mb-12">
            {processedBadge && <span class="conztru-badge mb-4 justify-center">{processedBadge}</span>}
            <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
              <span style="color:#0D1B2A;">{head} </span>
              {tail && <span class="conztru-italic-red">{tail}</span>}
            </h2>
            {processedDescription && (
              <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto" set:html={processedDescription} />
            )}
          </div>
        </AnimateOnScroll>
        <AnimateOnScroll animation="fade-up" delay={150}>
          <div class="rounded-3xl overflow-hidden h-[500px] shadow-2xl ring-1 ring-black/5">
            <iframe src={mapUrl} class="w-full h-full" style="border: 0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Location Map" />
          </div>
        </AnimateOnScroll>
      </>
    )}

    {(variant === "half" || variant === "split") && (
      <div class="grid lg:grid-cols-2 gap-8 items-stretch">
        <AnimateOnScroll animation="fade-right">
          <div class="rounded-3xl p-10 md:p-12 lg:p-14 flex flex-col h-full relative overflow-hidden" style="background-color:#0D1B2A;">
            <div class="absolute top-0 right-0 w-64 h-64 rounded-full -translate-y-1/3 translate-x-1/3" style="background-color:rgba(232,37,26,0.08);" />
            <div class="relative z-10 flex flex-col h-full">
              {processedBadge && variant === "split" && <span class="conztru-badge conztru-badge--light mb-5">{processedBadge}</span>}
              <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
                <span class="block text-white">{head}</span>
                {tail && <span class="block conztru-italic-red">{tail}</span>}
              </h2>
              {processedDescription && (
                <p class="on-dark text-lg md:text-xl text-white/70 mb-8" set:html={processedDescription} />
              )}
              {locations.length > 0 && (
                <div class="grid grid-cols-2 gap-4 mt-auto">
                  {locations.map((location) => (
                    <a href={location.href} class="group p-4 rounded-2xl bg-white/5 hover:bg-white/10 transition-all duration-300 border border-white/10">
                      <div class="flex items-center gap-2 mb-2">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background-color:#E8251A;">
                          <MapPin className="w-4 h-4 text-white" />
                        </div>
                        <span class="font-bold text-white text-sm">{location.name}</span>
                      </div>
                      <div class="flex items-center text-xs text-white/60 group-hover:text-[#E8251A] transition-colors">
                        View location
                        <ArrowRight className="w-3.5 h-3.5 ml-1 group-hover:translate-x-1 transition-transform" />
                      </div>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </AnimateOnScroll>
        <AnimateOnScroll animation="fade-left" delay={150}>
          <div class="rounded-3xl overflow-hidden min-h-[400px] lg:min-h-full shadow-2xl h-full ring-1 ring-black/5">
            <iframe src={mapUrl} class="w-full h-full" style="border: 0; min-height: 100%" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Location Map" />
          </div>
        </AnimateOnScroll>
      </div>
    )}

    {variant === "overlay-titled" && (
      <>
        <AnimateOnScroll animation="fade-up">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
              <span style="color:#0D1B2A;">{head} </span>
              {tail && <span class="conztru-italic-red">{tail}</span>}
            </h2>
            {processedDescription && (
              <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto" set:html={processedDescription} />
            )}
          </div>
        </AnimateOnScroll>
        <AnimateOnScroll animation="fade-up" delay={150}>
          <div class="relative rounded-3xl overflow-hidden min-h-[700px] hidden md:block">
            <div class="absolute inset-0">
              <iframe src={mapUrl} class="w-full h-full" style="border: 0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Service Area Map" />
            </div>
            <div class="absolute inset-0 p-6 md:p-10 lg:p-12 flex items-center pointer-events-none">
              <div class="locations-overlay-glass rounded-2xl p-8 md:p-10 w-full max-w-sm md:min-w-[24rem] pointer-events-auto">
                <span class="conztru-badge conztru-badge--light mb-5">{processedOverlayBadge}</span>
                <h3 class="text-3xl md:text-4xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
                  <span class="block text-white">{overlayHead}</span>
                  {overlayTail && <span class="block conztru-italic-red">{overlayTail}</span>}
                </h3>
                <div class="space-y-2">
                  <p class="text-xs font-bold uppercase tracking-[0.2em] mb-3" style="color:#FF7468;">Featured Locations</p>
                  {locations.map((location) => (
                    <a href={location.href} class="group flex items-center justify-between p-3 rounded-xl bg-white/5 hover:bg-white/10 transition-all duration-300">
                      <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full flex items-center justify-center" style="background-color:#E8251A;">
                          <MapPin className="w-4 h-4 text-white" />
                        </div>
                        <div>
                          <span class="font-bold text-white text-sm">{location.name}</span>
                          {location.description && (
                            <p class="text-xs text-white/55">{location.description}</p>
                          )}
                        </div>
                      </div>
                      <ArrowRight className="w-4 h-4 text-white/60 group-hover:text-[#E8251A] group-hover:translate-x-1 transition-all" />
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <!-- Mobile fallback -->
          <div class="md:hidden grid gap-8">
            <div class="rounded-3xl p-8" style="background-color:#0D1B2A;">
              <span class="conztru-badge conztru-badge--light mb-5">{processedOverlayBadge}</span>
              <h3 class="text-3xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
                <span class="block text-white">{overlayHead}</span>
                {overlayTail && <span class="block conztru-italic-red">{overlayTail}</span>}
              </h3>
              {locations.length > 0 && (
                <div class="grid grid-cols-2 gap-3">
                  {locations.map((location) => (
                    <a href={location.href} class="flex items-center gap-1.5 px-2.5 py-2.5 rounded-2xl bg-white/5 border border-white/10 min-w-0">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8251A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                        <circle cx="12" cy="10" r="3"/>
                      </svg>
                      <span class="font-bold text-white text-[0.78rem] leading-tight whitespace-nowrap">{location.name}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
            <div class="rounded-3xl overflow-hidden min-h-[400px] shadow-2xl">
              <iframe src={mapUrl} class="w-full h-full" style="border: 0; min-height: 100%" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Location Map" />
            </div>
          </div>
        </AnimateOnScroll>
      </>
    )}

    {variant === "overlay" && (
      <AnimateOnScroll animation="fade-up">
        <div class="relative rounded-3xl overflow-hidden min-h-[700px] hidden md:block">
          <div class="absolute inset-0">
            <iframe src={mapUrl} class="w-full h-full" style="border: 0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Service Area Map" />
          </div>
          <div class="absolute inset-0 p-6 md:p-10 lg:p-12 flex items-center pointer-events-none">
            <div class="locations-overlay-glass rounded-2xl p-8 md:p-10 w-full max-w-sm md:min-w-[24rem] pointer-events-auto">
              {processedBadge && <span class="conztru-badge conztru-badge--light mb-5">{processedBadge}</span>}
              <h2 class="text-3xl md:text-4xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
                <span class="block text-white">{head}</span>
                {tail && <span class="block conztru-italic-red">{tail}</span>}
              </h2>
              {processedDescription && (
                <p class="text-white/70 mb-6 text-balance">{processedDescription}</p>
              )}
              <div class="space-y-2">
                <p class="text-xs font-bold uppercase tracking-[0.2em] mb-3" style="color:#FF7468;">Featured Locations</p>
                {locations.map((location) => (
                  <a href={location.href} class="group flex items-center justify-between p-3 rounded-xl bg-white/5 hover:bg-white/10 transition-all duration-300">
                    <div class="flex items-center gap-3">
                      <div class="w-9 h-9 rounded-full flex items-center justify-center" style="background-color:#E8251A;">
                        <MapPin className="w-4 h-4 text-white" />
                      </div>
                      <div>
                        <span class="font-bold text-white text-sm">{location.name}</span>
                        {location.description && (
                          <p class="text-xs text-white/55">{location.description}</p>
                        )}
                      </div>
                    </div>
                    <ArrowRight className="w-4 h-4 text-white/60 group-hover:text-[#E8251A] group-hover:translate-x-1 transition-all" />
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
        <!-- Mobile fallback -->
        <div class="md:hidden grid gap-8">
          <div class="rounded-3xl p-8" style="background-color:#0D1B2A;">
            {processedBadge && <span class="conztru-badge conztru-badge--light mb-5">{processedBadge}</span>}
            <h2 class="text-3xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
              <span class="block text-white">{head}</span>
              {tail && <span class="block conztru-italic-red">{tail}</span>}
            </h2>
            {processedDescription && (
              <p class="text-base text-white/70 mb-8">{processedDescription}</p>
            )}
            {locations.length > 0 && (
              <div class="grid grid-cols-2 gap-3">
                {locations.map((location) => (
                  <a href={location.href} class="flex items-center gap-2 px-3 py-3 rounded-2xl bg-white/5 border border-white/10 min-w-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E8251A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span class="font-bold text-white text-sm leading-tight truncate">{location.name}</span>
                  </a>
                ))}
              </div>
            )}
          </div>
          <div class="rounded-3xl overflow-hidden min-h-[400px] shadow-2xl">
            <iframe src={mapUrl} class="w-full h-full" style="border: 0; min-height: 100%" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Location Map" />
          </div>
        </div>
      </AnimateOnScroll>
    )}
  </div>
</section>

<style>
  /* Glass card overlaying the map — matches showcase / editorial glass */
  .locations-overlay-glass {
    background-color: rgba(13, 27, 42, 0.78);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.10);
  }
</style>
