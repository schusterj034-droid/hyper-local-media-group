---
import AnimateOnScroll from "@/components/AnimateOnScroll.astro"
import { Phone, Mail, MapPin, Send } from "lucide-react"

interface ContactInfo {
  phone?: string
  phoneFormatted?: string
  email?: string
  location?: string
}

interface Props {
  title?: string
  description?: string
  secondaryDescription?: string
  contactInfo?: ContactInfo
  submitText?: string
  variant?: "default" | "split" | "card"
}

const {
  title = "Contact Us",
  description = "Ready to take your marketing to the next level? We'd love to hear from you.",
  secondaryDescription = "Fill out the form and we'll get back to you within 24 hours.",
  contactInfo = {
    phone: "+17206056959",
    phoneFormatted: "(720) 605-6959",
    email: "info@Denvermarketing.com",
    location: "Denver, Colorado"
  },
  submitText = "SUBMIT FORM",
  variant = "default"
} = Astro.props

const splitTitle = (t: string) => {
  if (t.includes("\n")) {
    const [a, ...rest] = t.split("\n")
    return { head: a.trim(), tail: rest.join(" ").trim() }
  }
  const words = t.split(" ")
  if (words.length < 3) return { head: t, tail: "" }
  const mid = Math.ceil(words.length / 2)
  return { head: words.slice(0, mid).join(" "), tail: words.slice(mid).join(" ") }
}
const { head, tail } = splitTitle(title)
---

<section class="py-14 sm:py-20 md:py-28" class:list={[variant === "card" ? "bg-gray-50" : "bg-white"]}>
  <div class="container mx-auto px-4">
    {variant === "split" && (
      <div class="grid lg:grid-cols-2 gap-0 rounded-3xl overflow-hidden shadow-2xl">
        <div class="conztru-contact-glass p-7 sm:p-10 md:p-14 lg:p-16 text-white relative overflow-hidden backdrop-blur-2xl border border-white/15">
          <div class="absolute top-0 right-0 w-64 h-64 rounded-full -translate-y-1/2 translate-x-1/2" style="background-color:rgba(232,37,26,0.08);" />
          <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full translate-y-1/2 -translate-x-1/2" style="background-color:rgba(232,37,26,0.05);" />

          <div class="relative z-10">
            <AnimateOnScroll animation="fade-right">
              <span class="conztru-badge mb-4 sm:mb-5">Let's Connect</span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
                <span class="block text-white">{head}</span>
                {tail && <span class="block conztru-italic-red">{tail}</span>}
              </h2>
              <p class="text-base sm:text-lg md:text-xl text-white/75 mb-4 leading-relaxed">{description}</p>
              <p class="text-sm sm:text-base text-white/55 mb-8 sm:mb-10 leading-relaxed">{secondaryDescription}</p>
            </AnimateOnScroll>

            <AnimateOnScroll animation="fade-up" delay={200}>
              <div class="space-y-3 sm:space-y-4">
                {contactInfo.phoneFormatted && (
                  <a href={`tel:${contactInfo.phone}`} class="flex items-center gap-3 sm:gap-4 group min-w-0">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center shrink-0 transition-transform group-hover:scale-110" style="background-color:#E8251A;">
                      <Phone className="w-5 h-5 text-white" />
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-white/55 uppercase tracking-wider">Phone</p>
                      <p class="text-sm sm:text-base font-bold">{contactInfo.phoneFormatted}</p>
                    </div>
                  </a>
                )}

                {contactInfo.email && (
                  <a href={`mailto:${contactInfo.email}`} class="flex items-center gap-3 sm:gap-4 group min-w-0">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center shrink-0 transition-transform group-hover:scale-110" style="background-color:#E8251A;">
                      <Mail className="w-5 h-5 text-white" />
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-white/55 uppercase tracking-wider">Email</p>
                      <p class="text-sm sm:text-base font-bold break-words">{contactInfo.email}</p>
                    </div>
                  </a>
                )}

                {contactInfo.location && (
                  <div class="flex items-center gap-3 sm:gap-4 min-w-0">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center shrink-0" style="background-color:#E8251A;">
                      <MapPin className="w-5 h-5 text-white" />
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-white/55 uppercase tracking-wider">Location</p>
                      <p class="text-sm sm:text-base font-bold">{contactInfo.location}</p>
                    </div>
                  </div>
                )}
              </div>
            </AnimateOnScroll>
          </div>
        </div>

        <div class="bg-white p-7 sm:p-10 md:p-14 lg:p-16">
          <AnimateOnScroll animation="fade-left">
            <form class="space-y-5 sm:space-y-6" x-data="{ submitting: false }" @submit.prevent="submitting = true; setTimeout(() => submitting = false, 1000)">
              <div>
                <label for="name" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Name</label>
                <input type="text" id="name" name="name" placeholder="Your name" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
              </div>
              <div>
                <label for="email" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Email address</label>
                <input type="email" id="email" name="email" placeholder="you@example.com" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Phone</label>
                <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
              </div>
              <div>
                <label for="message" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Message</label>
                <textarea id="message" name="message" placeholder="Tell us about your project..." rows="4" class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all resize-none"></textarea>
              </div>
              <button type="submit" :disabled="submitting" class="conztru-cta w-full md:w-auto inline-flex items-center justify-center gap-2 h-12 px-10 py-3 text-white font-bold rounded-full shadow-lg transition-all disabled:opacity-50">
                <span x-text={`submitting ? 'Sending...' : '${submitText}'`}></span>
                <Send className="w-5 h-5" />
              </button>
            </form>
          </AnimateOnScroll>
        </div>
      </div>
    )}

    {variant === "card" && (
      <>
        <AnimateOnScroll animation="fade-up">
          <div class="text-center max-w-2xl mx-auto mb-12">
            <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
              <span style="color:#0D1B2A;">{head} </span>
              {tail && <span class="conztru-italic-red">{tail}</span>}
            </h2>
            <p class="text-lg md:text-xl text-gray-600">{description}</p>
          </div>
        </AnimateOnScroll>

        <div class="max-w-4xl mx-auto">
          <AnimateOnScroll animation="fade-up" delay={100}>
            <div class="bg-white rounded-3xl shadow-xl p-8 md:p-12 border border-gray-100">
              <div class="grid md:grid-cols-3 gap-4 mb-10">
                {contactInfo.phoneFormatted && (
                  <a href={`tel:${contactInfo.phone}`} class="flex items-center gap-4 p-4 rounded-2xl transition-colors group" style="background-color:rgba(232,37,26,0.05);">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background-color:#E8251A;">
                      <Phone className="w-5 h-5 text-white" />
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 uppercase tracking-wider">Phone</p>
                      <p class="font-bold text-sm group-hover:text-[#E8251A] transition-colors" style="color:#0D1B2A;">{contactInfo.phoneFormatted}</p>
                    </div>
                  </a>
                )}

                {contactInfo.email && (
                  <a href={`mailto:${contactInfo.email}`} class="flex items-center gap-4 p-4 rounded-2xl transition-colors group" style="background-color:rgba(232,37,26,0.05);">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background-color:#E8251A;">
                      <Mail className="w-5 h-5 text-white" />
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 uppercase tracking-wider">Email</p>
                      <p class="font-bold text-sm group-hover:text-[#E8251A] transition-colors break-all" style="color:#0D1B2A;">{contactInfo.email}</p>
                    </div>
                  </a>
                )}

                {contactInfo.location && (
                  <div class="flex items-center gap-4 p-4 rounded-2xl" style="background-color:rgba(232,37,26,0.05);">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background-color:#E8251A;">
                      <MapPin className="w-5 h-5 text-white" />
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 uppercase tracking-wider">Location</p>
                      <p class="font-bold text-sm" style="color:#0D1B2A;">{contactInfo.location}</p>
                    </div>
                  </div>
                )}
              </div>

              <form class="space-y-6" x-data="{ submitting: false }" @submit.prevent="submitting = true; setTimeout(() => submitting = false, 1000)">
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <label for="name" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Name</label>
                    <input type="text" id="name" name="name" placeholder="Your name" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Email</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
                  </div>
                </div>
                <div>
                  <label for="phone" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Phone</label>
                  <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
                </div>
                <div>
                  <label for="message" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Message</label>
                  <textarea id="message" name="message" placeholder="Tell us about your project..." rows="4" class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all resize-none"></textarea>
                </div>
                <button type="submit" :disabled="submitting" class="conztru-cta w-full md:w-auto inline-flex items-center justify-center gap-2 h-12 px-8 py-3 text-white font-bold rounded-full transition-all disabled:opacity-50 shadow-lg">
                  <span x-text={`submitting ? 'Sending...' : '${submitText}'`}></span>
                  <Send className="w-5 h-5" />
                </button>
              </form>
            </div>
          </AnimateOnScroll>
        </div>
      </>
    )}

    {variant === "default" && (
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <AnimateOnScroll animation="fade-right">
          <div>
            <span class="conztru-badge mb-5">Get In Touch</span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl mb-6 leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
              <span style="color:#0D1B2A;">{head} </span>
              {tail && <span class="conztru-italic-red">{tail}</span>}
            </h2>
            <p class="text-lg md:text-xl text-gray-600 mb-4">{description}</p>
            <p class="text-gray-500 mb-10">{secondaryDescription}</p>

            <div class="space-y-5">
              {contactInfo.phoneFormatted && (
                <a href={`tel:${contactInfo.phone}`} class="flex items-center gap-4 group">
                  <div class="w-14 h-14 rounded-full flex items-center justify-center transition-all group-hover:scale-105" style="background-color:rgba(232,37,26,0.1);">
                    <Phone className="w-6 h-6" style={{ color: '#E8251A' }} />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">Phone</p>
                    <p class="text-base font-bold group-hover:text-[#E8251A] transition-colors" style="color:#0D1B2A;">{contactInfo.phoneFormatted}</p>
                  </div>
                </a>
              )}

              {contactInfo.email && (
                <a href={`mailto:${contactInfo.email}`} class="flex items-center gap-4 group">
                  <div class="w-14 h-14 rounded-full flex items-center justify-center transition-all group-hover:scale-105" style="background-color:rgba(232,37,26,0.1);">
                    <Mail className="w-6 h-6" style={{ color: '#E8251A' }} />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">Email</p>
                    <p class="text-base font-bold group-hover:text-[#E8251A] transition-colors" style="color:#0D1B2A;">{contactInfo.email}</p>
                  </div>
                </a>
              )}

              {contactInfo.location && (
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 rounded-full flex items-center justify-center" style="background-color:rgba(232,37,26,0.1);">
                    <MapPin className="w-6 h-6" style={{ color: '#E8251A' }} />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">Location</p>
                    <p class="text-base font-bold" style="color:#0D1B2A;">{contactInfo.location}</p>
                  </div>
                </div>
              )}
            </div>
          </div>
        </AnimateOnScroll>

        <AnimateOnScroll animation="fade-left">
          <div class="bg-white rounded-3xl shadow-xl p-8 md:p-10 border border-gray-100">
            <form class="space-y-6" x-data="{ submitting: false }" @submit.prevent="submitting = true; setTimeout(() => submitting = false, 1000)">
              <div>
                <label for="name" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Name</label>
                <input type="text" id="name" name="name" placeholder="Name" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
              </div>
              <div>
                <label for="email" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Email address</label>
                <input type="email" id="email" name="email" placeholder="Email address" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Phone</label>
                <input type="tel" id="phone" name="phone" placeholder="### ### ####" required class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all" />
              </div>
              <div>
                <label for="message" class="block text-sm font-bold mb-2" style="color:#0D1B2A;">Message</label>
                <textarea id="message" name="message" placeholder="Message" rows="4" class="conztru-input w-full px-4 py-4 rounded-xl border-2 outline-none transition-all resize-none"></textarea>
              </div>
              <button type="submit" :disabled="submitting" class="conztru-cta w-full inline-flex items-center justify-center gap-2 h-12 px-8 py-3 text-white font-bold rounded-full shadow-lg transition-all disabled:opacity-50">
                <span x-text={`submitting ? 'Sending...' : '${submitText}'`}></span>
              </button>
            </form>
          </div>
        </AnimateOnScroll>
      </div>
    )}
  </div>
</section>

<style>
  .conztru-input {
    border-color: #f3f4f6;
    background-color: #fafafa;
  }
  .conztru-input:focus {
    border-color: #E8251A;
    background-color: #fff;
  }
  .conztru-contact-glass {
    background: linear-gradient(135deg, rgba(13, 27, 42, 0.92) 0%, rgba(13, 27, 42, 0.78) 100%);
    box-shadow:
      0 8px 32px 0 rgba(13, 27, 42, 0.37),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.12);
  }
</style>
