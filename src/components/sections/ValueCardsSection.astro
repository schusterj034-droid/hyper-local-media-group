---
import { getLocationText } from "@/config/site"
import AnimateOnScroll from "@/components/AnimateOnScroll.astro"
import {
  MapPin, Users, DollarSign, Sparkles, Award, Target,
  Zap, Globe, TrendingUp, Heart, Shield, Clock,
  MessageSquare, Palette, Rocket, Settings, Wrench
} from "lucide-react"

const iconMap: Record<string, any> = {
  mappin: MapPin, pin: MapPin, users: Users, people: Users,
  dollar: DollarSign, money: DollarSign, sparkles: Sparkles, sparkle: Sparkles,
  award: Award, badge: Award, target: Target, zap: Zap, globe: Globe,
  trending: TrendingUp, heart: Heart, shield: Shield, clock: Clock,
  message: MessageSquare, chat: MessageSquare, palette: Palette, design: Palette,
  rocket: Rocket, launch: Rocket, settings: Settings, tools: Wrench, wrench: Wrench,
}

interface ValueCard {
  icon?: string
  title: string
  description: string
  image?: string
  href?: string
  imageFit?: "cover" | "contain"
}

interface Props {
  badge?: string
  title?: string
  description?: string
  cards: ValueCard[]
  variant?: "cards" | "minimal" | "overlay" | "marquee"
}

const { badge, title, description, cards, variant = "cards" } = Astro.props

const processedTitle = title ? getLocationText(title) : undefined
const processedDescription = description ? getLocationText(description) : undefined
const processedBadge = badge ? getLocationText(badge) : undefined
const count = cards.length

const getIcon = (iconName?: string) => iconMap[iconName?.toLowerCase() || ""] || Award

const getGridCols = () => {
  if (count <= 2) return count === 1 ? "md:grid-cols-1 max-w-2xl mx-auto" : "md:grid-cols-2 max-w-4xl mx-auto"
  if (count <= 4) return count === 3 ? "md:grid-cols-3" : "md:grid-cols-2 lg:grid-cols-4"
  if (count <= 6) return "md:grid-cols-2 lg:grid-cols-3"
  return "md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
}

const splitTitle = (t: string) => {
  if (!t) return { head: "", tail: "" }
  if (t.includes("\n")) {
    const [a, ...rest] = t.split("\n")
    return { head: a.trim(), tail: rest.join(" ").trim() }
  }
  const words = t.split(" ")
  if (words.length < 3) return { head: t, tail: "" }
  const mid = Math.ceil(words.length / 2)
  return { head: words.slice(0, mid).join(" "), tail: words.slice(mid).join(" ") }
}
const { head, tail } = processedTitle ? splitTitle(processedTitle) : { head: "", tail: "" }
---

<section class="py-20 md:py-28 bg-white" class:list={[variant === "marquee" && "overflow-hidden"]}>
  <div class="container mx-auto px-4" class:list={[variant === "marquee" && "mb-8"]}>
    {(processedTitle || processedBadge) && (
      <AnimateOnScroll animation="fade-up">
        <div class="text-center mb-14">
          {processedBadge && <span class="conztru-badge mb-4 justify-center">{processedBadge}</span>}
          {processedTitle && (
            <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
              <span style="color:#0D1B2A;">{head} </span>
              {tail && <span class="conztru-italic-red">{tail}</span>}
            </h2>
          )}
          {processedDescription && (
            <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto text-balance">{processedDescription}</p>
          )}
        </div>
      </AnimateOnScroll>
    )}
  </div>

  {variant === "cards" && (
    <div class="container mx-auto px-4">
      <div class={`grid gap-6 ${getGridCols()}`}>
        {cards.map((card, i) => {
          const Icon = getIcon(card.icon)
          return (
            <AnimateOnScroll animation="fade-up" delay={i * 100}>
              <article class:list={["sb-card group h-full flex flex-col", !card.image && "sb-card--minimal"]}>
                {card.image ? (
                  <div class="sb-card-media">
                    <img src={card.image} alt={getLocationText(card.title)} width="640" height="400" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                  </div>
                ) : (
                  <div class="sb-card-header--minimal"></div>
                )}

                <div class:list={["sb-card-icon", !card.image && "sb-card-icon--minimal"]}>
                  <Icon className="w-6 h-6 text-white" />
                </div>

                <div class="sb-card-body">
                  <h3 class="sb-card-title">{getLocationText(card.title)}</h3>
                  <p class="sb-card-desc" set:html={getLocationText(card.description)} />
                  {card.href && (
                    <a href={card.href} class="sb-card-link" aria-label={`Learn more about ${getLocationText(card.title)}`}>
                      <span aria-hidden="true">Learn more</span>
                      <span class="sr-only">about {getLocationText(card.title)}</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  )}
                </div>

                <span class="sb-card-accent" aria-hidden="true"></span>
              </article>
            </AnimateOnScroll>
          )
        })}
      </div>
    </div>
  )}

  {variant === "minimal" && (
    <div class="container mx-auto px-4">
      <div class={`grid gap-10 ${getGridCols()}`}>
        {cards.map((card, i) => {
          const Icon = getIcon(card.icon)
          return (
            <AnimateOnScroll animation="fade-up" delay={i * 100}>
              <div class="group text-center">
                <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-5 transition-all duration-500 shadow-lg group-hover:shadow-xl" style="background-color:#E8251A;">
                  <Icon className="w-9 h-9 text-white" />
                </div>
                <div class="conztru-stat-counter mb-2" style="color:#E8251A; font-family:'Barlow',sans-serif; font-weight:800; font-size:2rem; line-height:1;">
                  {(i + 1) * 100}+
                </div>
                <h3 class="text-base md:text-lg font-bold mb-3" style="color:#0D1B2A;">{getLocationText(card.title)}</h3>
                <p class="text-sm text-gray-600 leading-relaxed max-w-sm mx-auto" set:html={getLocationText(card.description)} />
              </div>
            </AnimateOnScroll>
          )
        })}
      </div>
    </div>
  )}

  {variant === "overlay" && (
    <div class="container mx-auto px-4">
      <div class={`grid gap-6 ${getGridCols()}`}>
        {cards.map((card, i) => {
          const Icon = getIcon(card.icon)
          return (
            <AnimateOnScroll animation="fade-up" delay={i * 100}>
              <div class="group relative h-80 rounded-2xl overflow-hidden cursor-pointer">
                {card.image ? (
                  <img src={card.image} alt={card.title} width="640" height="480" loading="lazy" decoding="async" class:list={["absolute inset-0 w-full h-full group-hover:scale-110 transition-transform duration-700 ease-out", card.imageFit === "contain" ? "object-contain bg-[#0D1B2A]" : "object-cover"]} />
                ) : (
                  <div class="absolute inset-0" style="background-color:#0D1B2A;" />
                )}
                <div class="absolute inset-0 transition-all duration-500 ease-out" style="background:linear-gradient(to top, rgba(13,27,42,0.95), rgba(13,27,42,0.55) 50%, rgba(13,27,42,0.2));"></div>
                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out" style="background:linear-gradient(to top, rgba(232,37,26,0.55), rgba(232,37,26,0.3) 50%, rgba(232,37,26,0.08));"></div>
                <div class="absolute inset-0 p-6 flex flex-col justify-end z-10">
                  <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mb-4 group-hover:bg-white group-hover:scale-110 transition-all duration-500 ease-out">
                    <Icon className="w-6 h-6 text-white group-hover:text-[#E8251A]" />
                  </div>
                  <h3 class="text-lg font-bold text-white mb-2">{getLocationText(card.title)}</h3>
                  <p class="on-dark text-white/85 text-sm leading-relaxed line-clamp-3 group-hover:line-clamp-none transition-all" set:html={getLocationText(card.description)} />
                </div>
              </div>
            </AnimateOnScroll>
          )
        })}
      </div>
    </div>
  )}
</section>

<style>
  /* Service Block card — shared with FeaturesSection */
  .sb-card {
    position: relative;
    background-color: #ffffff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 3px 6px rgba(13, 27, 42, 0.05), 0 10px 24px rgba(13, 27, 42, 0.12);
    transition: transform .35s ease, box-shadow .35s ease;
    isolation: isolate;
  }
  .sb-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 5px 10px rgba(13, 27, 42, 0.07), 0 22px 48px rgba(13, 27, 42, 0.18);
  }

  .sb-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: #0D1B2A;
    overflow: hidden;
  }
  .sb-card-media img {
    transition: transform .6s ease;
  }
  .sb-card:hover .sb-card-media img {
    transform: scale(1.06);
  }
  .sb-card-media-fallback {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 30% 20%, rgba(232,37,26,0.45), transparent 55%),
      linear-gradient(135deg, #0D1B2A 0%, #1a2a3f 100%);
  }

  .sb-card-icon {
    position: relative;
    margin: -32px 0 0 26px;
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    background-color: rgba(13, 27, 42, 0.45);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 8px 20px rgba(13, 27, 42, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.25);
    z-index: 2;
    transition: background-color .3s ease, transform .3s ease, border-color .3s ease;
  }
  .sb-card:hover .sb-card-icon {
    background-color: rgba(232, 37, 26, 0.55);
    border-color: rgba(255, 255, 255, 0.35);
    transform: scale(1.05);
  }

  .sb-card-body {
    padding: 18px 26px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .sb-card-title {
    font-family: 'Barlow', sans-serif;
    font-weight: 800;
    color: #0D1B2A;
    font-size: 1.25rem;
    line-height: 1.2;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }
  .sb-card-desc {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.55;
    margin-bottom: 18px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sb-card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #E8251A;
    text-decoration: none;
    transition: gap .25s ease;
  }
  .sb-card:hover .sb-card-link {
    gap: 10px;
  }

  .sb-card-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: #E8251A;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .4s ease;
  }
  .sb-card:hover .sb-card-accent {
    transform: scaleX(1);
  }

  /* Minimal variant — solid navy header bar + overlapping icon, no image */
  .sb-card--minimal {
    border: 1px solid rgba(13, 27, 42, 0.06);
  }
  .sb-card-header--minimal {
    width: 100%;
    height: 72px;
    background-color: #0D1B2A;
  }
  .sb-card-icon--minimal {
    background-color: #0D1B2A;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: none;
    box-shadow: 0 8px 18px rgba(13, 27, 42, 0.25);
  }
  .sb-card--minimal:hover .sb-card-icon--minimal {
    background-color: #E8251A;
    border: none;
  }
</style>
