---
import { getLocationText } from "@/config/site"
import AnimateOnScroll from "@/components/AnimateOnScroll.astro"
import { ChevronDown, Plus, Minus } from "lucide-react"

interface FAQ {
  question: string
  answer: string
}

interface Props {
  badge?: string
  title?: string
  description?: string
  faqs: FAQ[]
  variant?: "accordion" | "cards" | "minimal"
}

const {
  badge,
  title = "Frequently Asked Questions",
  description,
  faqs,
  variant = "accordion",
} = Astro.props

const processedTitle = getLocationText(title)
const processedDescription = description ? getLocationText(description) : undefined
const processedBadge = badge ? getLocationText(badge) : undefined

const splitTitle = (t: string) => {
  if (t.includes("\n")) {
    const [a, ...rest] = t.split("\n")
    return { head: a.trim(), tail: rest.join(" ").trim() }
  }
  const words = t.split(" ")
  if (words.length < 3) return { head: t, tail: "" }
  const mid = Math.ceil(words.length / 2)
  return { head: words.slice(0, mid).join(" "), tail: words.slice(mid).join(" ") }
}
const { head, tail } = splitTitle(processedTitle)
---

<section class="py-20 md:py-28 bg-white">
  <div class="container mx-auto px-4">
    {variant === "accordion" && (
      <div class="max-w-3xl mx-auto">
        <AnimateOnScroll animation="fade-up">
          <div class="text-center mb-14">
            {processedBadge && <span class="conztru-badge mb-4 justify-center">{processedBadge}</span>}
            <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
              <span style="color:#0D1B2A;">{head} </span>
              {tail && <span class="conztru-italic-red">{tail}</span>}
            </h2>
            {processedDescription && (
              <p class="text-lg md:text-xl text-gray-600 text-balance">
                {processedDescription}
              </p>
            )}
          </div>
        </AnimateOnScroll>

        <div class="space-y-4" x-data="{ openIndex: 0 }">
          {faqs.map((faq, index) => (
            <AnimateOnScroll animation="fade-up" delay={index * 100}>
              <div
                :class={`openIndex === ${index} ? 'border-[#E8251A]/60' : 'border-gray-200 hover:border-gray-300'`}
                :style={`openIndex === ${index} ? 'backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: linear-gradient(135deg, rgba(232,37,26,0.025) 0%, rgba(255,255,255,0.6) 100%); box-shadow: inset 0 1px 0 0 rgba(255,255,255,0.6);' : 'backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: linear-gradient(135deg, rgba(255,255,255,0.65) 0%, rgba(255,255,255,0.4) 100%); box-shadow: inset 0 1px 0 0 rgba(255,255,255,0.6);'`}
                class="rounded-2xl border transition-all duration-300"
              >
                <button
                  @click={`openIndex = openIndex === ${index} ? null : ${index}`}
                  :aria-expanded={`openIndex === ${index}`}
                  class="w-full flex items-center justify-between p-6 text-left"
                >
                  <span class="font-bold text-base md:text-lg pr-4" style="color:#0D1B2A;">{getLocationText(faq.question)}</span>
                  <div
                    :class={`openIndex === ${index} ? 'rotate-180 text-white' : 'text-gray-600'`}
                    :style={`openIndex === ${index} ? 'background-color:#E8251A;' : 'background-color:#f3f4f6;'`}
                    class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 transition-all duration-300"
                  >
                    <ChevronDown className="w-5 h-5" />
                  </div>
                </button>
                <div
                  x-show={`openIndex === ${index}`}
                  x-transition:enter="transition ease-out duration-300"
                  x-transition:enter-start="opacity-0 max-h-0"
                  x-transition:enter-end="opacity-100 max-h-96"
                  x-transition:leave="transition ease-in duration-200"
                  x-transition:leave-start="opacity-100 max-h-96"
                  x-transition:leave-end="opacity-0 max-h-0"
                  class="overflow-hidden"
                >
                  <p class="px-6 pb-6 text-base text-gray-600 leading-relaxed" set:html={getLocationText(faq.answer)} />
                </div>
              </div>
            </AnimateOnScroll>
          ))}
        </div>
      </div>
    )}

    {variant === "cards" && (
      <>
        <AnimateOnScroll animation="fade-up">
          <div class="text-center mb-14">
            {processedBadge && <span class="conztru-badge mb-4 justify-center">{processedBadge}</span>}
            <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
              <span style="color:#0D1B2A;">{head} </span>
              {tail && <span class="conztru-italic-red">{tail}</span>}
            </h2>
            {processedDescription && (
              <p class="text-lg md:text-xl text-gray-600 text-balance max-w-2xl mx-auto">
                {processedDescription}
              </p>
            )}
          </div>
        </AnimateOnScroll>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" x-data="{ openIndex: null }">
          {faqs.map((faq, index) => (
            <AnimateOnScroll animation="fade-up" delay={index * 100}>
              <div
                @click={`openIndex = openIndex === ${index} ? null : ${index}`}
                :class={`openIndex === ${index} ? 'text-white shadow-xl' : 'bg-gray-50 hover:bg-gray-100'`}
                :style={`openIndex === ${index} ? 'background-color:#0D1B2A;' : ''`}
                class="group rounded-2xl p-6 transition-all duration-300 cursor-pointer h-full"
              >
                <div class="flex items-start justify-between gap-4 mb-3">
                  <h3 :class={`openIndex === ${index} ? 'text-white' : 'text-[#0D1B2A]'`} class="font-bold text-base md:text-lg">
                    {getLocationText(faq.question)}
                  </h3>
                  <div :style={`openIndex === ${index} ? 'background-color:#E8251A;' : 'background-color:white;'`} class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-all">
                    <template x-if={`openIndex === ${index}`}>
                      <Minus className="w-4 h-4 text-white" />
                    </template>
                    <template x-if={`openIndex !== ${index}`}>
                      <Plus className="w-4 h-4" style={{ color: '#E8251A' }} />
                    </template>
                  </div>
                </div>
                <div x-show={`openIndex === ${index}`} x-transition class="overflow-hidden">
                  <p :class={`openIndex === ${index} ? 'text-white/80' : 'text-gray-600'`} class="on-dark text-sm leading-relaxed" set:html={getLocationText(faq.answer)} />
                </div>
                <p x-show={`openIndex !== ${index}`} class="text-sm text-gray-600 mt-2 line-clamp-2" set:html={getLocationText(faq.answer)} />
              </div>
            </AnimateOnScroll>
          ))}
        </div>
      </>
    )}

    {variant === "minimal" && (
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">
        <AnimateOnScroll animation="fade-right" class="lg:col-span-2 lg:sticky lg:top-28 lg:self-start">
          {processedBadge && <span class="conztru-badge mb-4">{processedBadge}</span>}
          <h2 class="text-3xl md:text-4xl lg:text-5xl mb-4 text-balance leading-tight" style="font-family:'Barlow',sans-serif; font-weight:800;">
            <span style="color:#0D1B2A;">{head} </span>
            {tail && <span class="conztru-italic-red">{tail}</span>}
          </h2>
          {processedDescription && (
            <p class="text-lg md:text-xl text-gray-600 text-balance">
              {processedDescription}
            </p>
          )}
          <div class="hidden lg:block mt-8 pt-8 border-t border-gray-100">
            <p class="text-sm text-gray-500 mb-2">Still have questions?</p>
            <a href="/contact-us" class="inline-flex items-center font-bold" style="color:#C41C12;">
              Contact our team
              <ChevronDown className="w-4 h-4 ml-1 -rotate-90" />
            </a>
          </div>
        </AnimateOnScroll>

        <div class="lg:col-span-3 space-y-0 divide-y divide-gray-100" x-data="{ openIndex: 0 }">
          {faqs.map((faq, index) => (
            <AnimateOnScroll animation="fade-left" delay={index * 100}>
              <div class="py-6 first:pt-0 last:pb-0">
                <button
                  @click={`openIndex = openIndex === ${index} ? null : ${index}`}
                  :aria-expanded={`openIndex === ${index}`}
                  class="w-full flex items-start justify-between text-left group"
                >
                  <span
                    :class={`openIndex === ${index} ? 'text-[#E8251A]' : 'text-[#0D1B2A] group-hover:text-[#E8251A]'`}
                    class="font-bold text-base md:text-lg pr-8 transition-colors"
                  >
                    {getLocationText(faq.question)}
                  </span>
                  <div
                    :style={`openIndex === ${index} ? 'border-color:#E8251A; background-color:#E8251A;' : 'border-color:#d1d5db;'`}
                    class="w-6 h-6 rounded-full border-2 flex items-center justify-center shrink-0 mt-1 transition-all"
                  >
                    <template x-if={`openIndex === ${index}`}>
                      <Minus className="w-3 h-3 text-white" />
                    </template>
                    <template x-if={`openIndex !== ${index}`}>
                      <Plus className="w-3 h-3 text-gray-400" />
                    </template>
                  </div>
                </button>
                <div x-show={`openIndex === ${index}`} x-transition class="overflow-hidden mt-4">
                  <p class="text-base text-gray-600 leading-relaxed pr-14" set:html={getLocationText(faq.answer)} />
                </div>
              </div>
            </AnimateOnScroll>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
