---
import { siteConfig } from "@/config/site"
import { footerConfig } from "@/config/navigation"
import { Facebook, Instagram, Linkedin, Twitter, Youtube, ChevronRight, ChevronDown, Phone, Mail, MapPin } from "lucide-react"

interface Props {
  variant?: "classic" | "centered" | "minimal"
}

const { variant = "classic" } = Astro.props

const socialIcons = {
  facebook: Facebook,
  instagram: Instagram,
  linkedin: Linkedin,
  twitter: Twitter,
  youtube: Youtube,
}

const currentYear = new Date().getFullYear()
const socialLinks = Object.entries(siteConfig.social).filter(([_, url]) => url)
const gridCols = Math.min(footerConfig.columns.length + 1, 4)
---

{variant === "classic" && (
  <footer class="text-white" style="background-color: #0D1B2A;">
    <div class="container mx-auto px-4">
      <!-- Top - logo + social -->
      <div class="py-14 flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 border-b" style="border-color: rgba(255,255,255,0.08);">
        <div class="max-w-md">
          <a href="/" class="inline-block mb-6">
            <img src={siteConfig.logo.whiteSrc} alt={siteConfig.logo.alt} class="h-12 w-auto object-contain" width="192" height="48" loading="lazy" decoding="async" />
          </a>
          <p class="text-white/60 text-sm leading-relaxed">
            {footerConfig.description}
          </p>
        </div>

        <div class="lg:text-right">
          {socialLinks.length > 0 && (
            <>
              <p class="text-xs uppercase tracking-[0.2em] font-semibold mb-4" style="color: #FF7468;">Connect With Us</p>
              <div class="flex lg:justify-end gap-3">
                {socialLinks.map(([platform, url]) => {
                  const Icon = socialIcons[platform as keyof typeof socialIcons]
                  if (!Icon) return null
                  return (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${siteConfig.business.name} on ${platform.charAt(0).toUpperCase() + platform.slice(1)}`}
                      class="w-10 h-10 rounded-full flex items-center justify-center text-white hover:text-white transition-all"
                      style="background-color: rgba(255,255,255,0.08);"
                      onmouseover="this.style.backgroundColor='#E8251A'"
                      onmouseout="this.style.backgroundColor='rgba(255,255,255,0.08)'"
                    >
                      <Icon className="w-5 h-5" aria-hidden="true" />
                    </a>
                  )
                })}
              </div>
            </>
          )}
        </div>
      </div>

      <!-- Middle columns -->
      <div class={`py-12 md:py-14 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-${Math.min(gridCols, 4)} gap-x-6 gap-y-10 md:gap-8 lg:gap-12`}>
        {footerConfig.columns.map((col) => (
          <div>
            {col.type === 'accordion' && (
              <>
                {col.href ? (
                  <a href={col.href} class="flex items-center gap-1 text-white font-bold mb-6 uppercase tracking-wider text-sm hover:text-[#E8251A] transition-colors">
                    {col.title.toUpperCase()} <ChevronRight className="w-4 h-4" />
                  </a>
                ) : (
                  <p class="text-white font-bold mb-6 uppercase tracking-wider text-sm">{col.title}</p>
                )}
                <div class="space-y-2" x-data="{ openSection: null }">
                  {col.sections.map((section) => (
                    <div>
                      <button
                        @click={`openSection = openSection === '${section.label}' ? null : '${section.label}'`}
                        :aria-expanded={`openSection === '${section.label}'`}
                        aria-label={`Toggle ${section.label} section`}
                        class="flex items-center justify-between gap-2 w-full py-2 text-sm text-white/70 hover:text-[#E8251A] transition-colors text-left"
                      >
                        <span class="uppercase tracking-wider text-xs font-semibold leading-tight">{section.label}</span>
                        <ChevronDown
                          className="w-4 h-4 shrink-0 transition-transform duration-200"
                          x-bind:class={`openSection === '${section.label}' && 'rotate-180'`}
                        />
                      </button>
                      <div
                        x-show={`openSection === '${section.label}'`}
                        x-transition:enter="transition ease-out duration-300"
                        x-transition:enter-start="opacity-0 -translate-y-2"
                        x-transition:enter-end="opacity-100 translate-y-0"
                        x-transition:leave="transition ease-in duration-200"
                        x-transition:leave-start="opacity-100 translate-y-0"
                        x-transition:leave-end="opacity-0 -translate-y-2"
                        class="mt-2"
                        style="display: none;"
                      >
                        <ul class="space-y-2">
                          {section.items.map((item) => (
                            <li>
                              <a href={item.href} class="text-sm text-white/60 hover:text-[#E8251A] transition-colors">
                                {item.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  ))}
                </div>
              </>
            )}

            {col.type === 'links' && (
              <>
                <p class="text-white font-bold mb-6 uppercase tracking-wider text-sm">
                  <span class="inline-block w-6 h-[2px] mr-2 align-middle" style="background-color: #E8251A;"></span>
                  {col.title}
                </p>
                <ul class="space-y-3">
                  {col.links.map((link) => (
                    <li>
                      <a href={link.href} class="text-sm text-white/70 hover:text-[#E8251A] transition-colors">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        ))}

        <div>
          <p class="text-white font-bold mb-6 uppercase tracking-wider text-sm">
            <span class="inline-block w-6 h-[2px] mr-2 align-middle" style="background-color: #E8251A;"></span>
            Contact Us
          </p>
          <ul class="space-y-3 text-sm text-white/70">
            <li class="flex items-start gap-2">
              <MapPin className="w-4 h-4 mt-0.5 shrink-0" style={{ color: '#E8251A' }} />
              <span>{siteConfig.location.city}</span>
            </li>
            <li class="flex items-start gap-2">
              <Phone className="w-4 h-4 mt-0.5 shrink-0" style={{ color: '#E8251A' }} />
              <a href={`tel:${siteConfig.contact.phone}`} class="hover:text-[#E8251A] transition-colors">{siteConfig.contact.phoneFormatted}</a>
            </li>
            <li class="flex items-start gap-2">
              <Mail className="w-4 h-4 mt-0.5 shrink-0" style={{ color: '#E8251A' }} />
              <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-[#E8251A] transition-colors break-words min-w-0">{siteConfig.contact.email}</a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Bottom -->
      <div class="py-6 border-t flex flex-col md:flex-row items-center justify-between gap-4" style="border-color: rgba(255,255,255,0.08);">
        <div class="flex items-center gap-4 text-sm text-white/50">
          {footerConfig.bottomLinks.map((link, i) => (
            <>
              {i > 0 && <span class="opacity-30">|</span>}
              <a href={link.href} class="hover:text-[#E8251A] transition-colors">{link.label}</a>
            </>
          ))}
        </div>
        <p class="text-sm text-white/50">
          {siteConfig.business.name} · {currentYear} · All rights reserved.
        </p>
      </div>
    </div>
  </footer>
)}

{variant === "centered" && (
  <footer class="text-white" style="background-color: #0D1B2A;">
    <div class="container mx-auto px-4">
      <div class="py-14 text-center border-b" style="border-color: rgba(255,255,255,0.08);">
        <a href="/" class="inline-block mb-4">
          <span class="md:hidden text-xl font-bold text-white">{siteConfig.business.name}</span>
          <img src={siteConfig.logo.src} alt={siteConfig.logo.alt} class="hidden md:block h-12 w-12 object-contain brightness-0 invert mx-auto" width="48" height="48" loading="lazy" decoding="async" />
        </a>
        <p class="text-white/60 text-sm max-w-lg mx-auto">
          {siteConfig.business.description} in {siteConfig.location.city}, {siteConfig.location.state}.
        </p>
      </div>

      <div class="py-10 space-y-8">
        <div class="flex flex-wrap justify-center gap-x-8 gap-y-3">
          <a href="/about-us" class="text-sm text-white/70 hover:text-[#E8251A] transition-colors">About</a>
          <a href="/solutions" class="text-sm text-white/70 hover:text-[#E8251A] transition-colors">Solutions</a>
          <a href="/indoor-billboards/screen-advertising" class="text-sm text-white/70 hover:text-[#E8251A] transition-colors">Screen Advertising</a>
          <a href="/indoor-billboards/become-a-venue-partner" class="text-sm text-white/70 hover:text-[#E8251A] transition-colors">Venue Partner</a>
          <a href="/indoor-billboards/locations" class="text-sm text-white/70 hover:text-[#E8251A] transition-colors">Locations</a>
          <a href="/contact-us" class="text-sm text-white/70 hover:text-[#E8251A] transition-colors">Contact</a>
        </div>

        <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm text-white/60">
          <span>{siteConfig.contact.phoneFormatted}</span>
          <span class="opacity-30">·</span>
          <span>{siteConfig.contact.email}</span>
          <span class="opacity-30">·</span>
          <span>{siteConfig.location.city}, {siteConfig.location.state}</span>
        </div>

        {socialLinks.length > 0 && (
          <div class="flex justify-center gap-4">
            {socialLinks.map(([platform, url]) => {
              const Icon = socialIcons[platform as keyof typeof socialIcons]
              if (!Icon) return null
              return (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${siteConfig.business.name} on ${platform.charAt(0).toUpperCase() + platform.slice(1)}`}
                  class="w-10 h-10 rounded-full flex items-center justify-center text-white hover:bg-[#E8251A] transition-all"
                  style="background-color: rgba(255,255,255,0.08);"
                >
                  <Icon className="w-5 h-5" aria-hidden="true" />
                </a>
              )
            })}
          </div>
        )}
      </div>

      <div class="py-6 border-t text-center" style="border-color: rgba(255,255,255,0.08);">
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-white/50">
          <span>© {currentYear} {siteConfig.business.name}</span>
          <a href="/terms" class="hover:text-[#E8251A] transition-colors">Terms</a>
          <a href="/privacy" class="hover:text-[#E8251A] transition-colors">Privacy</a>
        </div>
      </div>
    </div>
  </footer>
)}

{variant === "minimal" && (
  <footer class="text-white py-8" style="background-color: #0D1B2A;">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
        <a href="/">
          <span class="md:hidden text-base font-bold text-white">{siteConfig.business.name}</span>
          <img src={siteConfig.logo.src} alt={siteConfig.logo.alt} class="hidden md:block h-8 w-8 object-contain brightness-0 invert" width="32" height="32" loading="lazy" decoding="async" />
        </a>

        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-white/70">
          <a href="/about-us" class="hover:text-[#E8251A] transition-colors">About</a>
          <a href="/solutions" class="hover:text-[#E8251A] transition-colors">Solutions</a>
          <a href="/contact-us" class="hover:text-[#E8251A] transition-colors">Contact</a>
          <span class="hidden md:inline opacity-30">|</span>
          <a href="/terms" class="hover:text-[#E8251A] transition-colors">Terms</a>
          <a href="/privacy" class="hover:text-[#E8251A] transition-colors">Privacy</a>
        </div>

        <p class="text-sm text-white/50">© {currentYear} {siteConfig.business.name}</p>
      </div>
    </div>
  </footer>
)}
